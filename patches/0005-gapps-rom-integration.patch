diff --git a/device.mk b/device.mk
index f6f1b33..3cf9258 100644
--- a/device.mk
+++ b/device.mk
@@ -12,6 +12,9 @@ $(call inherit-product-if-exists, device/samsung/x1q/s20volte_ims/s20volte_ims.m
 # NFC/eSE hardware fault fix (disable secure_element HAL + NFC features)
 $(call inherit-product-if-exists, device/samsung/x1q/nfcsefix/nfcsefix.mk)
 
+# MindTheGapps integrated into the ROM (survives product.img flashes)
